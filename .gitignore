# Segredos locais (RNF03): só o modelo .env.example é versionado
.env
.env.*
!.env.example

# Ajustes locais do Compose (ex.: trocar a porta 8080): não versionar
docker-compose.override.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Site gerado pelo MkDocs
site/

# Backups de volumes podem conter fotos de pessoas: nunca versionar
backups/
*.tar.gz

# Temporários de editor / sistema
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
