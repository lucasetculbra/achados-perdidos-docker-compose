# Modelo de configuração. Copie para ".env" e troque a senha:
#   cp .env.example .env            (Linux/macOS/Git Bash)
#   Copy-Item .env.example .env     (PowerShell)
# O arquivo ".env" é local e NUNCA deve ser versionado (está no .gitignore).
# Os valores abaixo são fictícios.
POSTGRES_DB=achados
POSTGRES_USER=achados_app
POSTGRES_PASSWORD=troque-esta-senha-ficticia
